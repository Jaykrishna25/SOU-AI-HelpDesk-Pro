generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
  FACULTY
  HOD
  HOI
  OWNER
  SUPER_ADMIN
}

model User {
  passwordHash      String?
  mustChangePassword Boolean  @default(true)
  passwordChangedAt DateTime?
  failedLogins      Int      @default(0)
  lockedUntil       DateTime?
  tokenVersion      Int      @default(0)
  mfaEnabled        Boolean  @default(false)
  mfaSecret         String?
  id           String   @id @default(cuid())
  loginId      String   @unique
  role         Role
  fullName     String
  email        String?  @unique
  birthdate    DateTime
  phone        String?
  institute    String?
  course       String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())

  student      Student?
  faculty      Faculty?
  admin        Admin?
  createdTickets Ticket[]      @relation("TicketCreator")
  notifications  Notification[]
  auditLogs      AuditLog[]

  // Named relations because a User appears on both sides of a conversation
     // and Prisma cannot tell the two apart without them.
  studentConversations Conversation[] @relation("ConversationStudent")
  facultyConversations Conversation[] @relation("ConversationFaculty")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  students  Student[]
  faculty   Faculty[]
  subjects  Subject[]
}

model Student {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentNo String @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  semester     Int    @default(1)
  program      String
  cgpa         Float  @default(0)

  fees     Fee[]
  results  Result[]
}

model Faculty {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  facultyId    String @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  designation  String @default("Assistant Professor")

  subjects Subject[]
}

model Admin {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId String @unique
  scope   String @default("CAMPUS")
}

model Subject {
  id           String @id @default(cuid())
  code         String @unique
  name         String
  semester     Int
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  facultyId    String?
  faculty      Faculty?   @relation(fields: [facultyId], references: [id])

  results Result[]
  exams   Exam[]
}

model Fee {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester  Int
  totalFees Float
  paidFees  Float    @default(0)
  status    String   @default("PENDING")
  dueDate   DateTime
}

model Result {
  id            String  @id @default(cuid())
  studentId     String
  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject @relation(fields: [subjectId], references: [id])
  semester      Int
  internalMarks Float   @default(0)
  externalMarks Float   @default(0)
  grade         String?
}

model Exam {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  title     String
  type      String
  date      DateTime
  venue     String
}

model Ticket {
  id          String   @id @default(cuid())
  code        String   @unique
  subject     String
  description String
  category    String   @default("GENERAL")
  priority    String   @default("MEDIUM")
  status      String   @default("Open")
  stage       String   @default("ADMIN")
  note        String   @default("")
  creatorId   String
  creator     User     @relation("TicketCreator", fields: [creatorId], references: [id])
  creatorName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  history TicketHistory[]
}

model TicketHistory {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event     String
  actor     String
  note      String   @default("")
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CRAssignment {
  id           String   @id @default(cuid())
  subjectCode  String   @unique
  subjectName  String
  enrollmentNo String
  studentName  String
  assignedBy   String
  createdAt    DateTime @default(now())
}

model AttendanceSubmission {
  id                 String   @id @default(cuid())
  subjectCode        String
  subjectName        String
  date               String
  markedByEnrollment String
  markedByName       String
  entries            Json
  status             String   @default("PENDING")
  syncState          String   @default("NOT_SYNCED")
  approvedBy         String   @default("")
  createdAt          DateTime @default(now())
}

model KnowledgeBase {
  id        String   @id @default(cuid())
  title     String
  type      String
  content   String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  actorRole String?
  action    String
  entity    String
  entityId  String?
  summary   String?
  detail    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}



// ===================== GreenReserve + institutional features =====================

enum ResourceType {
  CLASSROOM
  LAB
  LIBRARY_SEAT
  SPORTS
  PARKING
  AUDITORIUM
  EQUIPMENT
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum AlertKind {
  LOW_ATTENDANCE
  FEE_OVERDUE
  RESULT_RISK
  TICKET_SURGE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum GrievanceStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

model Resource {
  id         String       @id @default(cuid())
  code       String       @unique
  name       String
  type       ResourceType
  capacity   Int          @default(1)
  building   String?
  floor      String?
  location   String?
  department String?
  ecoScore   Int          @default(50)
  areaSqm    Float        @default(0)
  powerKw    Float        @default(0)
  openHour   Int          @default(8)
  closeHour  Int          @default(20)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  bookings   Booking[]

  @@index([type])
  @@index([department])
}

model Booking {
  id         String        @id @default(cuid())
  code       String        @unique
  resourceId String
  resource   Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  userName   String
  userRole   String
  purpose    String
  attendees  Int           @default(1)
  startsAt   DateTime
  endsAt     DateTime
  status     BookingStatus @default(PENDING)
  note       String?
  decidedBy  String?
  decidedAt  DateTime?
  energyKwh  Float         @default(0)
  co2Kg      Float         @default(0)
  createdAt  DateTime      @default(now())

  @@index([userId])
  @@index([status])
  @@index([resourceId, startsAt])
}

model QRSession {
  id            String    @id @default(cuid())
  token         String    @unique
  subjectName   String
  className     String
  crUserId      String
  facultyUserId String?
  sessionDate   DateTime  @default(now())
  expiresAt     DateTime
  rotateSeconds Int       @default(20)
  expectedCount Int       @default(0)
  closed        Boolean   @default(false)
  approved      Boolean   @default(false)
  approvedBy    String?
  approvedAt    DateTime?
  syncState     String    @default("PENDING")
  createdAt     DateTime  @default(now())
  scans         QRScan[]

  @@index([crUserId])
  @@index([closed])
}

model QRScan {
  id            String    @id @default(cuid())
  sessionId     String
  session       QRSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentUserId String
  studentName   String
  enrollment    String?
  scannedAt     DateTime  @default(now())

  @@unique([sessionId, studentUserId])
  @@index([studentUserId])
}

model RiskAlert {
  id            String        @id @default(cuid())
  studentUserId String?
  studentName   String?
  department    String?
  kind          AlertKind
  severity      AlertSeverity @default(WARNING)
  metric        Float?
  threshold     Float?
  message       String
  forecastFor   DateTime?
  acknowledged  Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@index([kind])
  @@index([severity])
  @@index([studentUserId])
}

model SustainabilityMetric {
  id             String   @id @default(cuid())
  day            DateTime
  department     String   @default("ALL")
  energyKwhUsed  Float    @default(0)
  energyKwhSaved Float    @default(0)
  co2KgSaved     Float    @default(0)
  seatHoursSaved Float    @default(0)
  utilisationPct Float    @default(0)
  bookingsCount  Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([day, department])
}

model SeatingPlan {
  id        String           @id @default(cuid())
  code      String           @unique
  examName  String
  examDate  DateTime
  rule      String           @default("NO_SAME_COURSE_ADJACENT")
  roomsJson String
  totalSeats Int             @default(0)
  createdBy String
  createdAt DateTime         @default(now())
  seats     SeatAllocation[]
}

model SeatAllocation {
  id          String      @id @default(cuid())
  planId      String
  plan        SeatingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  room        String
  rowNo       Int
  colNo       Int
  seatNo      String
  studentName String
  enrollment  String
  course      String?

  @@index([planId, room])
}

model FeedbackForm {
  id            String             @id @default(cuid())
  code          String             @unique
  subjectName   String
  facultyUserId String?
  facultyName   String
  department    String?
  term          String
  opensAt       DateTime           @default(now())
  closesAt      DateTime
  active        Boolean            @default(true)
  createdBy     String
  createdAt     DateTime           @default(now())
  responses     FeedbackResponse[]

  @@index([facultyUserId])
  @@index([active])
}

model FeedbackResponse {
  id             String       @id @default(cuid())
  formId         String
  form           FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  respondentHash String
  clarity        Int
  engagement     Int
  fairness       Int
  availability   Int
  overall        Int
  comment        String?
  createdAt      DateTime     @default(now())

  @@unique([formId, respondentHash])
}

model Grievance {
  id          String          @id @default(cuid())
  code        String          @unique
  category    String
  subject     String
  body        String
  identityRef String?
  status      GrievanceStatus @default(OPEN)
  response    String?
  respondedBy String?
  respondedAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([status])
  @@index([category])
}

model ReportExport {
  id          String   @id @default(cuid())
  code        String   @unique
  kind        String
  title       String
  periodFrom  DateTime
  periodTo    DateTime
  payloadJson String
  generatedBy String
  generatedAt DateTime @default(now())

  @@index([kind])
}



// ===================== IQAC / Quality Evidence Vault =====================

enum EvidenceType {
  FILE
  URL
  STRUCTURED
  NARRATIVE
}
enum EvidenceVisibility {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}
enum VerificationStatus {
  UNVERIFIED
  IN_REVIEW
  VERIFIED
  REJECTED
}
enum ApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
}
enum MetricKind {
  COUNT
  PERCENTAGE
  RATIO
  CURRENCY
  TEXT
  BOOLEAN
}
enum ActionStatus {
  PLANNED
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}
enum IssueKind {
  MISSING_EVIDENCE
  DUPLICATE
  INCONSISTENT_TOTAL
  INVALID_DATE
  UNVERIFIED_METRIC
  UNSOURCED_FIGURE
  EXPIRING_DOCUMENT
}
enum IssueSeverity {
  INFO
  WARNING
  CRITICAL
}
enum DataSourceKind {
  INTERNAL
  EXTERNAL
  MANUAL
}

model AcademicYear {
  id          String   @id @default(cuid())
  code        String   @unique          // "2025-26"
  startsOn    DateTime
  endsOn      DateTime
  isCurrent   Boolean  @default(false)
  locked      Boolean  @default(false)  // frozen once submitted
  createdAt   DateTime @default(now())

  targets     MetricTarget[]
  evidence    EvidenceRecord[]
  actionPlans ActionPlan[]
  snapshots   ReportSnapshot[]
  issues      DataQualityIssue[]
}

model QualityCriterion {
  id          String   @id @default(cuid())
  framework   String   @default("NAAC")  // configurable - never assumed in code
  code        String                      // "1"
  title       String
  description String?
  weightage   Float?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  indicators  KeyIndicator[]
  actionPlans ActionPlan[]

  @@unique([framework, code])
  @@index([framework, sortOrder])
}

model KeyIndicator {
  id           String   @id @default(cuid())
  criterionId  String
  criterion    QualityCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  code         String            // "1.1"
  title        String
  description  String?
  weightage    Float?
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)

  metrics      QualityMetric[]

  @@unique([criterionId, code])
}

model QualityMetric {
  id               String   @id @default(cuid())
  keyIndicatorId   String
  keyIndicator     KeyIndicator @relation(fields: [keyIndicatorId], references: [id], onDelete: Cascade)
  code             String               // "1.1.1"
  title            String
  description      String?
  kind             MetricKind @default(COUNT)
  unit             String?
  formula          String?              // human-readable definition, evaluated server-side only
  requiredEvidence String?              // what documents satisfy this metric
  sortOrder        Int      @default(0)
  active           Boolean  @default(true)

  targets   MetricTarget[]
  owners    MetricOwner[]
  evidence  EvidenceRecord[]
  issues    DataQualityIssue[]

  @@unique([keyIndicatorId, code])
}

model MetricTarget {
  id             String   @id @default(cuid())
  metricId       String
  metric         QualityMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  targetValue    Float?
  targetText     String?
  weightage      Float?
  note           String?

  @@unique([metricId, academicYearId])
}

model MetricOwner {
  id           String  @id @default(cuid())
  metricId     String
  metric       QualityMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  userId       String
  userName     String
  departmentId String?
  note         String?

  @@unique([metricId, userId])
  @@index([userId])
}

model EvidenceRecord {
  id                 String   @id @default(cuid())
  code               String   @unique
  metricId           String
  metric             QualityMetric @relation(fields: [metricId], references: [id])
  academicYearId     String
  academicYear       AcademicYear  @relation(fields: [academicYearId], references: [id])
  departmentId       String?
  departmentName     String?

  ownerUserId        String
  ownerName          String

  title              String
  evidenceType       EvidenceType @default(FILE)
  urlValue           String?
  structuredJson     String?
  narrative          String?
  evidenceDate       DateTime
  sourceSystem       String?
  sourceReference    String?

  visibility         EvidenceVisibility @default(INTERNAL)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  approvalStatus     ApprovalStatus     @default(DRAFT)
  lastVerifiedAt     DateTime?
  expiresAt          DateTime?
  isDemo             Boolean  @default(false)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  documents     EvidenceDocument[]
  versions      EvidenceVersion[]
  verifications EvidenceVerification[]
  approvals     EvidenceApproval[]
  actionItems   ActionItem[]

  @@index([metricId, academicYearId])
  @@index([departmentId])
  @@index([approvalStatus])
  @@index([verificationStatus])
  @@index([expiresAt])
}

model EvidenceDocument {
  id               String   @id @default(cuid())
  evidenceRecordId String
  evidenceRecord   EvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  fileName         String
  mimeType         String
  sizeBytes        Int
  blobUrl          String
  blobPathname     String
  checksum         String?
  versionNo        Int      @default(1)
  isCurrent        Boolean  @default(true)
  uploadedBy       String
  uploadedAt       DateTime @default(now())

  @@index([evidenceRecordId, isCurrent])
}

model EvidenceVersion {
  id               String   @id @default(cuid())
  evidenceRecordId String
  evidenceRecord   EvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  versionNo        Int
  snapshotJson     String
  changeNote       String?
  changedBy        String
  createdAt        DateTime @default(now())

  @@unique([evidenceRecordId, versionNo])
}

model EvidenceVerification {
  id               String   @id @default(cuid())
  evidenceRecordId String
  evidenceRecord   EvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  checklistJson    String
  result           VerificationStatus
  comments         String?
  verifiedBy       String
  verifiedByRole   String?
  verifiedAt       DateTime @default(now())

  @@index([evidenceRecordId])
}

model EvidenceApproval {
  id               String   @id @default(cuid())
  evidenceRecordId String
  evidenceRecord   EvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  decision         ApprovalStatus
  comments         String?
  decidedBy        String
  decidedByRole    String?
  decidedAt        DateTime @default(now())

  @@index([evidenceRecordId])
}

model ActionPlan {
  id             String   @id @default(cuid())
  code           String   @unique
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  criterionId    String?
  criterion      QualityCriterion? @relation(fields: [criterionId], references: [id])
  departmentId   String?
  departmentName String?
  title          String
  objective      String?
  ownerUserId    String?
  ownerName      String?
  startsOn       DateTime?
  dueOn          DateTime?
  status         ActionStatus @default(PLANNED)
  createdBy      String
  createdAt      DateTime @default(now())

  items ActionItem[]

  @@index([academicYearId, status])
}

model ActionItem {
  id               String   @id @default(cuid())
  actionPlanId     String
  actionPlan       ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  title            String
  ownerName        String?
  dueOn            DateTime?
  status           ActionStatus @default(PLANNED)
  completedAt      DateTime?
  evidenceRecordId String?
  evidenceRecord   EvidenceRecord? @relation(fields: [evidenceRecordId], references: [id])

  @@index([actionPlanId, status])
}

model ReportSnapshot {
  id                   String   @id @default(cuid())
  code                 String   @unique
  kind                 String
  title                String
  academicYearId       String?
  academicYear         AcademicYear? @relation(fields: [academicYearId], references: [id])
  periodFrom           DateTime
  periodTo             DateTime
  payloadJson          String
  statementSourcesJson String?              // every statement mapped to its evidence IDs
  generatedBy          String
  approvedBy           String?
  approvedAt           DateTime?
  publishedAt          DateTime?
  createdAt            DateTime @default(now())

  @@index([kind, createdAt])
}

model DataSource {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  kind         DataSourceKind @default(INTERNAL)
  description  String?
  ownerName    String?
  trusted      Boolean  @default(false)
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
}

model DataQualityIssue {
  id             String   @id @default(cuid())
  kind           IssueKind
  severity       IssueSeverity @default(WARNING)
  entity         String
  entityId       String?
  metricId       String?
  metric         QualityMetric? @relation(fields: [metricId], references: [id])
  academicYearId String?
  academicYear   AcademicYear?  @relation(fields: [academicYearId], references: [id])
  message        String
  detail         String?
  resolved       Boolean  @default(false)
  resolvedBy     String?
  resolvedAt     DateTime?
  detectedAt     DateTime @default(now())

  @@index([kind, resolved])
  @@index([severity, resolved])
}


// ===================== AI assistant: RAG + conversation memory =====================

model KnowledgeChunk {
  id         String   @id @default(cuid())
  sourceType String                     // KB | DOC | POLICY | FAQ
  sourceKey  String                     // stable id, e.g. "kb:fees" or "doc:ARCHITECTURE.md#3"
  title      String
  content    String
  embedding  Float[]                    // cosine similarity computed in application code
  lang       String   @default("en")
  charCount  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sourceKey])
  @@index([sourceType, active])
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  language  String   @default("en-IN")
  createdAt DateTime @default(now())
  turns     ChatTurn[]

  @@index([userId])
}

model ChatTurn {
  id          String   @id @default(cuid())
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String                    // user | ai
  text        String
  language    String?
  sourcesJson String?                   // chunk ids and titles used for this answer
  confidence  Float?
  latencyMs   Int?
  createdAt   DateTime @default(now())

  @@index([sessionId, createdAt])
}

// ===================== WebAuthn: passkeys, face and fingerprint unlock =====================
// Stores public keys only. No biometric data is transmitted or stored - the
// fingerprint or face template never leaves the user's device.

model Passkey {
  id             String   @id @default(cuid())
  userId         String
  credentialId   String   @unique          // base64url
  publicKey      String                    // base64url COSE key
  counter        BigInt   @default(0)      // replay protection
  deviceType     String?                   // singleDevice | multiDevice
  backedUp       Boolean  @default(false)
  transports     String?                   // JSON array: internal, hybrid, usb...
  label          String                    // "Windows Hello on my laptop"
  lastUsedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([userId])
}

model WebAuthnChallenge {
  id        String   @id @default(cuid())
  loginId   String
  challenge String
  purpose   String                          // register | authenticate
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([loginId, purpose])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Fun Zone: daily puzzles and a weekly leaderboard.
//
// Deliberately NOT linked to User by a foreign key relation - a play record is
// not academic data and should not widen the User model's blast radius. The
// userId is stored plainly so the leaderboard can group by it, along with a
// display name captured at play time.
// ---------------------------------------------------------------------------
model GameScore {
  id         String   @id @default(cuid())
  userId     String
  userName   String
  userRole   String
  game       String              // "grid" | "scramble" | "sequence"
  puzzleDate String              // YYYY-MM-DD, the puzzle played
  score      Int
  durationMs Int      @default(0)
  moves      Int      @default(0)
  weekKey    String              // YYYY-Www, so a weekly board is one index hit
  createdAt  DateTime @default(now())

  @@unique([userId, game, puzzleDate])   // one scoring run per puzzle per day
  @@index([weekKey, game])
  @@index([userId])
  @@index([createdAt])
}

// The morning briefing agent's memory.
//
// One row per user. `seenUrls` is what the agent has already shown them, so
// tomorrow it can report what is genuinely new rather than repeating itself -
// which is the difference between a briefing and a daily spam.
//
// Progression elsewhere in this portal is derived rather than stored; this is
// not, because "what did I already say" cannot be recomputed from anything.
/// A generated study timetable. The slots are computed in lib/plan-core.ts,
/// not by a model, so the arithmetic is testable.
model StudyPlanRun {
  id          String   @id @default(cuid())
  userId      String
  goal        String
  days        Int
  hoursPerDay Float
  strategy    String   @db.Text
  subjects    Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  tasks       StudyTask[]

  @@index([userId, active])
}

model StudyTask {
  id      String       @id @default(cuid())
  planId  String
  plan    StudyPlanRun @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId  String
  day     Int
  date    DateTime
  start   String
  end     String
  subject String
  title   String
  mode    String
  minutes Int
  done    Boolean      @default(false)
  doneAt  DateTime?

  @@index([userId, planId])
  @@index([userId, doneAt])
}

/// Self-study practice only. Never a mark, never on a transcript.
model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  total     Int
  correct   Int
  source    String   @default("subject")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Briefing {
  id        String   @id @default(cuid())
  userId    String   @unique
  body      String   @db.Text
  greeting  String
  plan      Json
  // New job openings shown in the most recent briefing.
  listings  Json
  // New AI models and open-source tools shown in the most recent briefing.
  releases  Json     @default("[]")
  newCount  Int      @default(0)
  releaseCount Int   @default(0)
  // Every URL this student has been shown, across all three feeds. Bounded.
  seenUrls  String[] @default([])
  model     String   @default("")
  runs      Int      @default(0)
  lastRunAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================================
   // Course material shared by faculty with their students.
//
   // The blob is stored PRIVATE and streamed back through an
   // authenticated route, exactly as IQAC evidence is. A public
   // blob URL would be simpler, and it would also mean anything a
   // lecturer uploads is readable by anyone who ever sees the link
   // - including after the student leaves. Course material is not
   // secret, but it is not the open web either, and the portal
   // already owns the pattern for serving a file to a signed-in
   // person.
//
   // `subject` is free text rather than a relation to Subject.
   // That is a deliberate concession: the seed does not reliably
   // link a Faculty row to Subject rows, so a hard relation would
   // make the feature unusable for exactly the accounts meant to
   // use it. If that link is tightened later, this becomes a
   // foreign key and the data migrates cleanly.
   // ============================================================
model CourseMaterial {
  id           String   @id @default(cuid())
  title        String
  description  String?
  subject      String
  semester     Int?
  fileName     String
  mimeType     String
  sizeBytes    Int
  blobUrl      String
  blobPathname String
  checksum     String?
  uploadedById String
  uploadedBy   String
  uploadedAt   DateTime @default(now())
  // Withdrawn rather than deleted: a student may have been told to read
     // something that is later pulled, and an audit trail that loses the row
     // cannot answer what they were asked to read.
  visible      Boolean  @default(true)

  @@index([subject, visible])
  @@index([uploadedById])
  @@index([uploadedAt])
}

// ============================================================
   // Direct student-to-faculty conversations.
//
   // A ticket is the right tool when a student needs the
   // institution: it has a queue, an owner, an SLA and an
   // escalation path. It is the wrong tool for "can I see you
   // about the lab submission" - that question does not need a
   // desk, and routing it through one buries a thirty-second
   // exchange under a workflow.
//
   // Two decisions worth defending:
//
   // 1. PARTICIPANTS ARE FIXED AT CREATION. A conversation is
      // between exactly one student and exactly one faculty
      // member, stored as two columns rather than a join table.
      // Nobody can be added later. A group thread would need a
      // membership model and a rule about who may add whom, and
      // every message already sent would retrospectively acquire
      // a new reader.
//
   // 2. MESSAGES ARE KEPT. Unlike the class-group chat - which is
      // deliberately never stored, because it is sixty people's
      // data uploaded by one of them - this is a conversation
      // both parties knowingly had inside the portal, and a
      // student needs to be able to point at what they were told.
      // That also means it is disclosable, and the UI says so.
   // ============================================================
model Conversation {
  id           String   @id @default(cuid())
  studentId    String
  student      User     @relation("ConversationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  facultyId    String
  faculty      User     @relation("ConversationFaculty", fields: [facultyId], references: [id], onDelete: Cascade)
  subject      String
  // Denormalised so a list of threads is one query, not one per thread.
  lastMessageAt DateTime @default(now())
  lastSnippet   String   @default("")
  // Either side may close it; either side may reopen by replying.
  closed       Boolean  @default(false)
  createdAt    DateTime @default(now())

  messages     Message[]

  // One open thread per pair per subject line keeps the list navigable
     // without forbidding a student from ever raising a second topic.
  @@index([studentId, lastMessageAt])
  @@index([facultyId, lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderName     String
  senderRole     String
  body           String
  sentAt         DateTime @default(now())
  // Read receipts are per-thread rather than per-message: the only question
     // the UI asks is "has the other side seen this thread since I wrote".
  readByStudent  Boolean  @default(false)
  readByFaculty  Boolean  @default(false)

  @@index([conversationId, sentAt])
}
