generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
  FACULTY
  HOD
  HOI
  OWNER
  SUPER_ADMIN
}

model User {
  passwordHash      String?
  mustChangePassword Boolean  @default(true)
  passwordChangedAt DateTime?
  failedLogins      Int      @default(0)
  lockedUntil       DateTime?
  tokenVersion      Int      @default(0)
  mfaEnabled        Boolean  @default(false)
  mfaSecret         String?
  id           String   @id @default(cuid())
  loginId      String   @unique
  role         Role
  fullName     String
  email        String?  @unique
  birthdate    DateTime
  phone        String?
  institute    String?
  course       String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())

  student      Student?
  faculty      Faculty?
  admin        Admin?
  createdTickets Ticket[]      @relation("TicketCreator")
  notifications  Notification[]
  auditLogs      AuditLog[]
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  students  Student[]
  faculty   Faculty[]
  subjects  Subject[]
}

model Student {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentNo String @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  semester     Int    @default(1)
  program      String
  cgpa         Float  @default(0)

  fees     Fee[]
  results  Result[]
}

model Faculty {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  facultyId    String @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  designation  String @default("Assistant Professor")

  subjects Subject[]
}

model Admin {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId String @unique
  scope   String @default("CAMPUS")
}

model Subject {
  id           String @id @default(cuid())
  code         String @unique
  name         String
  semester     Int
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  facultyId    String?
  faculty      Faculty?   @relation(fields: [facultyId], references: [id])

  results Result[]
  exams   Exam[]
}

model Fee {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester  Int
  totalFees Float
  paidFees  Float    @default(0)
  status    String   @default("PENDING")
  dueDate   DateTime
}

model Result {
  id            String  @id @default(cuid())
  studentId     String
  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject @relation(fields: [subjectId], references: [id])
  semester      Int
  internalMarks Float   @default(0)
  externalMarks Float   @default(0)
  grade         String?
}

model Exam {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  title     String
  type      String
  date      DateTime
  venue     String
}

model Ticket {
  id          String   @id @default(cuid())
  code        String   @unique
  subject     String
  description String
  category    String   @default("GENERAL")
  priority    String   @default("MEDIUM")
  status      String   @default("Open")
  stage       String   @default("ADMIN")
  note        String   @default("")
  creatorId   String
  creator     User     @relation("TicketCreator", fields: [creatorId], references: [id])
  creatorName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  history TicketHistory[]
}

model TicketHistory {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event     String
  actor     String
  note      String   @default("")
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CRAssignment {
  id           String   @id @default(cuid())
  subjectCode  String   @unique
  subjectName  String
  enrollmentNo String
  studentName  String
  assignedBy   String
  createdAt    DateTime @default(now())
}

model AttendanceSubmission {
  id                 String   @id @default(cuid())
  subjectCode        String
  subjectName        String
  date               String
  markedByEnrollment String
  markedByName       String
  entries            Json
  status             String   @default("PENDING")
  syncState          String   @default("NOT_SYNCED")
  approvedBy         String   @default("")
  createdAt          DateTime @default(now())
}

model KnowledgeBase {
  id        String   @id @default(cuid())
  title     String
  type      String
  content   String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  actorRole String?
  action    String
  entity    String
  entityId  String?
  summary   String?
  detail    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}



// ===================== GreenReserve + institutional features =====================

enum ResourceType {
  CLASSROOM
  LAB
  LIBRARY_SEAT
  SPORTS
  PARKING
  AUDITORIUM
  EQUIPMENT
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum AlertKind {
  LOW_ATTENDANCE
  FEE_OVERDUE
  RESULT_RISK
  TICKET_SURGE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum GrievanceStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

model Resource {
  id         String       @id @default(cuid())
  code       String       @unique
  name       String
  type       ResourceType
  capacity   Int          @default(1)
  building   String?
  floor      String?
  location   String?
  department String?
  ecoScore   Int          @default(50)
  areaSqm    Float        @default(0)
  powerKw    Float        @default(0)
  openHour   Int          @default(8)
  closeHour  Int          @default(20)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  bookings   Booking[]

  @@index([type])
  @@index([department])
}

model Booking {
  id         String        @id @default(cuid())
  code       String        @unique
  resourceId String
  resource   Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  userName   String
  userRole   String
  purpose    String
  attendees  Int           @default(1)
  startsAt   DateTime
  endsAt     DateTime
  status     BookingStatus @default(PENDING)
  note       String?
  decidedBy  String?
  decidedAt  DateTime?
  energyKwh  Float         @default(0)
  co2Kg      Float         @default(0)
  createdAt  DateTime      @default(now())

  @@index([userId])
  @@index([status])
  @@index([resourceId, startsAt])
}

model QRSession {
  id            String    @id @default(cuid())
  token         String    @unique
  subjectName   String
  className     String
  crUserId      String
  facultyUserId String?
  sessionDate   DateTime  @default(now())
  expiresAt     DateTime
  rotateSeconds Int       @default(20)
  expectedCount Int       @default(0)
  closed        Boolean   @default(false)
  approved      Boolean   @default(false)
  approvedBy    String?
  approvedAt    DateTime?
  syncState     String    @default("PENDING")
  createdAt     DateTime  @default(now())
  scans         QRScan[]

  @@index([crUserId])
  @@index([closed])
}

model QRScan {
  id            String    @id @default(cuid())
  sessionId     String
  session       QRSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentUserId String
  studentName   String
  enrollment    String?
  scannedAt     DateTime  @default(now())

  @@unique([sessionId, studentUserId])
  @@index([studentUserId])
}

model RiskAlert {
  id            String        @id @default(cuid())
  studentUserId String?
  studentName   String?
  department    String?
  kind          AlertKind
  severity      AlertSeverity @default(WARNING)
  metric        Float?
  threshold     Float?
  message       String
  forecastFor   DateTime?
  acknowledged  Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@index([kind])
  @@index([severity])
  @@index([studentUserId])
}

model SustainabilityMetric {
  id             String   @id @default(cuid())
  day            DateTime
  department     String   @default("ALL")
  energyKwhUsed  Float    @default(0)
  energyKwhSaved Float    @default(0)
  co2KgSaved     Float    @default(0)
  seatHoursSaved Float    @default(0)
  utilisationPct Float    @default(0)
  bookingsCount  Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([day, department])
}

model SeatingPlan {
  id        String           @id @default(cuid())
  code      String           @unique
  examName  String
  examDate  DateTime
  rule      String           @default("NO_SAME_COURSE_ADJACENT")
  roomsJson String
  totalSeats Int             @default(0)
  createdBy String
  createdAt DateTime         @default(now())
  seats     SeatAllocation[]
}

model SeatAllocation {
  id          String      @id @default(cuid())
  planId      String
  plan        SeatingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  room        String
  rowNo       Int
  colNo       Int
  seatNo      String
  studentName String
  enrollment  String
  course      String?

  @@index([planId, room])
}

model FeedbackForm {
  id            String             @id @default(cuid())
  code          String             @unique
  subjectName   String
  facultyUserId String?
  facultyName   String
  department    String?
  term          String
  opensAt       DateTime           @default(now())
  closesAt      DateTime
  active        Boolean            @default(true)
  createdBy     String
  createdAt     DateTime           @default(now())
  responses     FeedbackResponse[]

  @@index([facultyUserId])
  @@index([active])
}

model FeedbackResponse {
  id             String       @id @default(cuid())
  formId         String
  form           FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  respondentHash String
  clarity        Int
  engagement     Int
  fairness       Int
  availability   Int
  overall        Int
  comment        String?
  createdAt      DateTime     @default(now())

  @@unique([formId, respondentHash])
}

model Grievance {
  id          String          @id @default(cuid())
  code        String          @unique
  category    String
  subject     String
  body        String
  identityRef String?
  status      GrievanceStatus @default(OPEN)
  response    String?
  respondedBy String?
  respondedAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([status])
  @@index([category])
}

model ReportExport {
  id          String   @id @default(cuid())
  code        String   @unique
  kind        String
  title       String
  periodFrom  DateTime
  periodTo    DateTime
  payloadJson String
  generatedBy String
  generatedAt DateTime @default(now())

  @@index([kind])
}



// ===================== IQAC / Quality Evidence Vault =====================

enum EvidenceType {
  FILE
  URL
  STRUCTURED
  NARRATIVE
}
enum EvidenceVisibility {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}
enum VerificationStatus {
  UNVERIFIED
  IN_REVIEW
  VERIFIED
  REJECTED
}
enum ApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
}
enum MetricKind {
  COUNT
  PERCENTAGE
  RATIO
  CURRENCY
  TEXT
  BOOLEAN
}
enum ActionStatus {
  PLANNED
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}
enum IssueKind {
  MISSING_EVIDENCE
  DUPLICATE
  INCONSISTENT_TOTAL
  INVALID_DATE
  UNVERIFIED_METRIC
  UNSOURCED_FIGURE
  EXPIRING_DOCUMENT
}
enum IssueSeverity {
  INFO
  WARNING
  CRITICAL
}
enum DataSourceKind {
  INTERNAL
  EXTERNAL
  MANUAL
}

model AcademicYear {
  id          String   @id @default(cuid())
  code        String   @unique          // "2025-26"
  startsOn    DateTime
  endsOn      DateTime
  isCurrent   Boolean  @default(false)
  locked      Boolean  @default(false)  // frozen once submitted
  createdAt   DateTime @default(now())

  targets     MetricTarget[]
  evidence    EvidenceRecord[]
  actionPlans ActionPlan[]
  snapshots   ReportSnapshot[]
  issues      DataQualityIssue[]
}

model QualityCriterion {
  id          String   @id @default(cuid())
  framework   String   @default("NAAC")  // configurable - never assumed in code
  code        String                      // "1"
  title       String
  description String?
  weightage   Float?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  indicators  KeyIndicator[]
  actionPlans ActionPlan[]

  @@unique([framework, code])
  @@index([framework, sortOrder])
}

model KeyIndicator {
  id           String   @id @default(cuid())
  criterionId  String
  criterion    QualityCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  code         String            // "1.1"
  title        String
  description  String?
  weightage    Float?
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)

  metrics      QualityMetric[]

  @@unique([criterionId, code])
}

model QualityMetric {
  id               String   @id @default(cuid())
  keyIndicatorId   String
  keyIndicator     KeyIndicator @relation(fields: [keyIndicatorId], references: [id], onDelete: Cascade)
  code             String               // "1.1.1"
  title            String
  description      String?
  kind             MetricKind @default(COUNT)
  unit             String?
  formula          String?              // human-readable definition, evaluated server-side only
  requiredEvidence String?              // what documents satisfy this metric
  sortOrder        Int      @default(0)
  active           Boolean  @default(true)

  targets   MetricTarget[]
  owners    MetricOwner[]
  evidence  EvidenceRecord[]
  issues    DataQualityIssue[]

  @@unique([keyIndicatorId, code])
}

model MetricTarget {
  id             String   @id @default(cuid())
  metricId       String
  metric         QualityMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  targetValue    Float?
  targetText     String?
  weightage      Float?
  note           String?

  @@unique([metricId, academicYearId])
}

model MetricOwner {
  id           String  @id @default(cuid())
  metricId     String
  metric       QualityMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  userId       String
  userName     String
  departmentId String?
  note         String?

  @@unique([metricId, userId])
  @@index([userId])
}

model EvidenceRecord {
  id                 String   @id @default(cuid())
  code               String   @unique
  metricId           String
  metric             QualityMetric @relation(fields: [metricId], references: [id])
  academicYearId     String
  academicYear       AcademicYear  @relation(fields: [academicYearId], references: [id])
  departmentId       String?
  departmentName     String?

  ownerUserId        String
  ownerName          String

  title              String
  evidenceType       EvidenceType @default(FILE)
  urlValue           String?
  structuredJson     String?
  narrative          String?
  evidenceDate       DateTime
  sourceSystem       String?
  sourceReference    String?

  visibility         EvidenceVisibility @default(INTERNAL)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  approvalStatus     ApprovalStatus     @default(DRAFT)
  lastVerifiedAt     DateTime?
  expiresAt          DateTime?
  isDemo             Boolean  @default(false)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  documents     EvidenceDocument[]
  versions      EvidenceVersion[]
  verifications EvidenceVerification[]
  approvals     EvidenceApproval[]
  actionItems   ActionItem[]

  @@index([metricId, academicYearId])
  @@index([departmentId])
  @@index([approvalStatus])
  @@index([verificationStatus])
  @@index([expiresAt])
}

model EvidenceDocument {
  id               String   @id @default(cuid())
  evidenceRecordId String
  evidenceRecord   EvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  fileName         String
  mimeType         String
  sizeBytes        Int
  blobUrl          String
  blobPathname     String
  checksum         String?
  versionNo        Int      @default(1)
  isCurrent        Boolean  @default(true)
  uploadedBy       String
  uploadedAt       DateTime @default(now())

  @@index([evidenceRecordId, isCurrent])
}

model EvidenceVersion {
  id               String   @id @default(cuid())
  evidenceRecordId String
  evidenceRecord   EvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  versionNo        Int
  snapshotJson     String
  changeNote       String?
  changedBy        String
  createdAt        DateTime @default(now())

  @@unique([evidenceRecordId, versionNo])
}

model EvidenceVerification {
  id               String   @id @default(cuid())
  evidenceRecordId String
  evidenceRecord   EvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  checklistJson    String
  result           VerificationStatus
  comments         String?
  verifiedBy       String
  verifiedByRole   String?
  verifiedAt       DateTime @default(now())

  @@index([evidenceRecordId])
}

model EvidenceApproval {
  id               String   @id @default(cuid())
  evidenceRecordId String
  evidenceRecord   EvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  decision         ApprovalStatus
  comments         String?
  decidedBy        String
  decidedByRole    String?
  decidedAt        DateTime @default(now())

  @@index([evidenceRecordId])
}

model ActionPlan {
  id             String   @id @default(cuid())
  code           String   @unique
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  criterionId    String?
  criterion      QualityCriterion? @relation(fields: [criterionId], references: [id])
  departmentId   String?
  departmentName String?
  title          String
  objective      String?
  ownerUserId    String?
  ownerName      String?
  startsOn       DateTime?
  dueOn          DateTime?
  status         ActionStatus @default(PLANNED)
  createdBy      String
  createdAt      DateTime @default(now())

  items ActionItem[]

  @@index([academicYearId, status])
}

model ActionItem {
  id               String   @id @default(cuid())
  actionPlanId     String
  actionPlan       ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  title            String
  ownerName        String?
  dueOn            DateTime?
  status           ActionStatus @default(PLANNED)
  completedAt      DateTime?
  evidenceRecordId String?
  evidenceRecord   EvidenceRecord? @relation(fields: [evidenceRecordId], references: [id])

  @@index([actionPlanId, status])
}

model ReportSnapshot {
  id                   String   @id @default(cuid())
  code                 String   @unique
  kind                 String
  title                String
  academicYearId       String?
  academicYear         AcademicYear? @relation(fields: [academicYearId], references: [id])
  periodFrom           DateTime
  periodTo             DateTime
  payloadJson          String
  statementSourcesJson String?              // every statement mapped to its evidence IDs
  generatedBy          String
  approvedBy           String?
  approvedAt           DateTime?
  publishedAt          DateTime?
  createdAt            DateTime @default(now())

  @@index([kind, createdAt])
}

model DataSource {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  kind         DataSourceKind @default(INTERNAL)
  description  String?
  ownerName    String?
  trusted      Boolean  @default(false)
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
}

model DataQualityIssue {
  id             String   @id @default(cuid())
  kind           IssueKind
  severity       IssueSeverity @default(WARNING)
  entity         String
  entityId       String?
  metricId       String?
  metric         QualityMetric? @relation(fields: [metricId], references: [id])
  academicYearId String?
  academicYear   AcademicYear?  @relation(fields: [academicYearId], references: [id])
  message        String
  detail         String?
  resolved       Boolean  @default(false)
  resolvedBy     String?
  resolvedAt     DateTime?
  detectedAt     DateTime @default(now())

  @@index([kind, resolved])
  @@index([severity, resolved])
}


// ===================== AI assistant: RAG + conversation memory =====================

model KnowledgeChunk {
  id         String   @id @default(cuid())
  sourceType String                     // KB | DOC | POLICY | FAQ
  sourceKey  String                     // stable id, e.g. "kb:fees" or "doc:ARCHITECTURE.md#3"
  title      String
  content    String
  embedding  Float[]                    // cosine similarity computed in application code
  lang       String   @default("en")
  charCount  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sourceKey])
  @@index([sourceType, active])
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  language  String   @default("en-IN")
  createdAt DateTime @default(now())
  turns     ChatTurn[]

  @@index([userId])
}

model ChatTurn {
  id          String   @id @default(cuid())
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String                    // user | ai
  text        String
  language    String?
  sourcesJson String?                   // chunk ids and titles used for this answer
  confidence  Float?
  latencyMs   Int?
  createdAt   DateTime @default(now())

  @@index([sessionId, createdAt])
}
